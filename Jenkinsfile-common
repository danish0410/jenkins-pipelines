@Library("common-lib-unified@feature") _

def app = null

properties([
  parameters([

    // 🧠 Dynamic GitHub Repo Loader
    [$class: 'CascadeChoiceParameter',
      choiceType: 'PT_SINGLE_SELECT',
      filterLength: 1,
      filterable: true,
      name: 'REPO_NAME',
      description: 'Select repo from danish0410 (excluding common*)',
      randomName: 'repoNameParam',
      referencedParameters: '',
      script: [
        $class: 'GroovyScript',
        fallbackScript: [classpath: [], sandbox: true, script: 'return ["error-fetching-repos"]'],
        script: [classpath: [], sandbox: true, script: '''
          import groovy.json.JsonSlurper
          import java.net.URL
          import jenkins.model.*
          import com.cloudbees.plugins.credentials.*

          def creds = com.cloudbees.plugins.credentials.CredentialsProvider.lookupCredentials(
              com.cloudbees.plugins.credentials.impl.StringCredentialsImpl.class,
              Jenkins.instance,
              null,
              null
          ).find { it.id == 'github-api-token' }

          if (!creds) return ["missing-token"]

          def githubToken = creds.secret.getPlainText()
          def connection = new URL("https://api.github.com/users/danish0410/repos").openConnection()
          connection.setRequestProperty("Authorization", "token ${githubToken}")
          connection.connect()

          def repos = new JsonSlurper().parse(connection.inputStream)
          return repos.collect { it.name }.findAll { !it.startsWith("common") }.sort()
        ''']
      ]
    ],

    // 🔁 Dynamic REPO_BRANCH Picker (based on REPO_NAME)
    [$class: 'CascadeChoiceParameter',
      choiceType: 'PT_SINGLE_SELECT',
      filterLength: 1,
      filterable: true,
      name: 'REPO_BRANCH',
      description: 'Branches from selected GitHub repo',
      randomName: 'repoBranchParam',
      referencedParameters: 'REPO_NAME',
      script: [
        $class: 'GroovyScript',
        fallbackScript: [classpath: [], sandbox: true, script: 'return ["error-fetching-branches"]'],
        script: [classpath: [], sandbox: true, script: '''
          import groovy.json.JsonSlurper
          import java.net.URL
          import jenkins.model.*
          import com.cloudbees.plugins.credentials.*

          def repo = REPO_NAME
          if (!repo) return ["select-a-repo"]

          def creds = com.cloudbees.plugins.credentials.CredentialsProvider.lookupCredentials(
              com.cloudbees.plugins.credentials.impl.StringCredentialsImpl.class,
              Jenkins.instance,
              null,
              null
          ).find { it.id == 'github-api-token' }

          if (!creds) return ["missing-token"]

          def githubToken = creds.secret.getPlainText()
          def apiUrl = "https://api.github.com/repos/danish0410/${repo}/branches"

          def connection = new URL(apiUrl).openConnection()
          connection.setRequestProperty("Authorization", "token ${githubToken}")
          connection.connect()

          def branches = new JsonSlurper().parse(connection.inputStream)
          return branches.collect { it.name }.sort()
        ''']
      ]
    ],

    // 🌍 Environment
    choice(
      name: 'ENV_STAGE',
      choices: ['dev', 'staging', 'prod'],
      description: 'Deployment Environment'
    ),

    // 🧱 Shared Library Branch
    string(
      name: 'LIBRARY_BRANCH',
      defaultValue: 'feature',
      description: 'Branch of Shared Library (common-lib-unified)'
    )
  ])
])

import org.commonlibunified.ApplicationBuilder

pipeline {
  agent any

  tools {
    git 'Git'
  }

  stages {
    stage('Load Shared Library & Init') {
      steps {
        script {
          library("common-lib-unified@${params.LIBRARY_BRANCH}")
          app = new ApplicationBuilder(this)
          app.initialize()
        }
      }
    }

    stage('Startup Debug') {
      steps {
        echo "⚙️ REPO_NAME: ${params.REPO_NAME}"
        echo "⚙️ REPO_BRANCH: ${params.REPO_BRANCH}"
        echo "⚙️ ENV_STAGE: ${params.ENV_STAGE}"
        echo "📚 LIBRARY_BRANCH: ${params.LIBRARY_BRANCH}"
      }
    }

    stage('Clean Workspace') {
      steps {
        script { app.cleanWorkspace() }
      }
    }

    stage('Checkout Repo') {
      steps {
        script { app.checkout(params.REPO_BRANCH) }
      }
    }

    stage('Build Application') {
      steps {
        script { app.build(params.REPO_BRANCH) }
      }
    }

    stage('Pre-Run Debug') {
      steps {
        script { app.preRunDebug() }
      }
    }

    stage('Start MySQL (if needed)') {
      when {
        expression { app?.appType == 'springboot' }
      }
      steps {
        script { app.startMySQLContainer() }
      }
    }

    stage('Run Container') {
      steps {
        script { app.runContainer() }
      }
    }

    stage('Health Check') {
      steps {
        script { app.healthCheck() }
      }
    }

    stage('Success') {
      steps {
        echo "🎉 Deployment successful for ${params.REPO_NAME} [${params.REPO_BRANCH}] in ${params.ENV_STAGE}"
      }
    }
  }

  post {
    failure {
      echo '❌ Deployment failed. Check logs.'
    }
    always {
      echo '🎯 Pipeline execution completed.'
    }
  }
}
