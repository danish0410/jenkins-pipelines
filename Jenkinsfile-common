def app = null

properties([
  parameters([
    // --- Static REPO_NAME Choice ---
    choice(
      name: 'REPO_NAME',
      choices: [
        'git@github.com:danish0410/springboot-role.git',
        'git@github.com:danish0410/php-nginx-helloworld.git',
        'git@github.com:danish0410/nginx-p81.git'
      ],
      description: 'Repository SSH URL to checkout'
    ),

    // --- Static REPO_BRANCH Choice ---
    choice(
      name: 'REPO_BRANCH',
      choices: ['main', 'dev', 'feature'],
      description: 'Branch to checkout'
    ),

    // --- Static ENV_STAGE ---
    choice(
      name: 'ENV_STAGE',
      choices: ['dev', 'staging', 'prod'],
      description: 'Deployment Environment'
    ),

    // --- Shared Library Branch ---
    string(
      name: 'LIBRARY_BRANCH',
      defaultValue: 'feature',
      description: 'Branch of Shared Library (common-lib-unified)'
    )
  ])
])

pipeline {
  agent any

  tools {
    git 'Git'
  }

  stages {
    stage('Load Shared Library & Init') {
      steps {
        script {
          // Dynamically load shared library
          library("common-lib-unified@${params.LIBRARY_BRANCH}")

          // Extract only the repo name from the full git URL
          def repoUrl = params.REPO_NAME
          def repoName = repoUrl.split('/').last().replace('.git', '')

          // Initialize ApplicationBuilder
          def builderClass = evaluate("org.commonlibunified.ApplicationBuilder")
          app = builderClass.newInstance(this)
          app.initialize(repoName, params.ENV_STAGE)
        }
      }
    }

    stage('Startup Debug') {
      steps {
        echo "⚙️ REPO_NAME: ${params.REPO_NAME}"
        echo "⚙️ REPO_BRANCH: ${params.REPO_BRANCH}"
        echo "⚙️ ENV_STAGE: ${params.ENV_STAGE}"
        echo "📚 LIBRARY_BRANCH: ${params.LIBRARY_BRANCH}"
      }
    }

    stage('Clean Workspace') {
      steps {
        script { app.cleanWorkspace() }
      }
    }

    stage('Checkout Repo') {
      steps {
        script {
          app.checkout(params.REPO_BRANCH)
        }
      }
    }

    stage('Build Application') {
      steps {
        script {
          app.build(params.REPO_BRANCH)
        }
      }
    }

    stage('Pre-Run Debug') {
      steps {
        script {
          app.preRunDebug()
        }
      }
    }

    stage('Start MySQL (if needed)') {
      when {
        expression { app?.appType == 'springboot' }
      }
      steps {
        script {
          app.startMySQLContainer()
        }
      }
    }

    stage('Run Container') {
      steps {
        script {
          app.runContainer()
        }
      }
    }

    stage('Health Check') {
      steps {
        script {
          app.healthCheck()
        }
      }
    }

    stage('Success') {
      steps {
        echo "🎉 Deployment successful for ${params.REPO_NAME} [${params.REPO_BRANCH}] in ${params.ENV_STAGE}"
      }
    }
  }

  post {
    failure {
      echo '❌ Deployment failed. Check logs.'
    }
    always {
      echo '🎯 Pipeline execution completed.'
    }
  }
}
