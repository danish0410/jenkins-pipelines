def app = null

properties([
  parameters([
    [$class: 'CascadeChoiceParameter',
      choiceType: 'PT_SINGLE_SELECT',
      name: 'REPO_NAME',
      description: 'Repository Name to checkout',
      filterable: true,
      script: [
        $class: 'GroovyScript',
        script: [classpath: [], sandbox: false, script:
          '''
          import groovy.json.JsonSlurper
          def token = Jenkins.instance.getExtensionList('com.cloudbees.plugins.credentials.CredentialsProvider')[0]
              .getCredentials(com.cloudbees.plugins.credentials.CredentialsMatchers.withId('github-api-token'))[0]
              .getSecret().getPlainText()
          def repos = []
          def apiUrl = "https://api.github.com/users/danish0410/repos?per_page=100"
          def connection = new URL(apiUrl).openConnection()
          connection.setRequestProperty("Authorization", "token ${token}")
          def response = connection.inputStream.text
          def json = new groovy.json.JsonSlurper().parseText(response)
          json.each {
              if (!it.name.startsWith("common")) {
                  repos << it.name
              }
          }
          return repos.sort()
          '''
        ],
        fallbackScript: [
          classpath: [],
          sandbox: false,
          script: 'return ["springboot-role"]'
        ]
      ]
    ],

    [$class: 'CascadeChoiceParameter',
      choiceType: 'PT_SINGLE_SELECT',
      name: 'REPO_BRANCH',
      description: 'Branch to checkout',
      filterable: true,
      referencedParameters: 'REPO_NAME',
      script: [
        $class: 'GroovyScript',
        script: [classpath: [], sandbox: false, script:
          '''
          import groovy.json.JsonSlurper
          def token = Jenkins.instance.getExtensionList('com.cloudbees.plugins.credentials.CredentialsProvider')[0]
              .getCredentials(com.cloudbees.plugins.credentials.CredentialsMatchers.withId('github-api-token'))[0]
              .getSecret().getPlainText()
          def repoName = REPO_NAME
          def branches = []
          if (repoName) {
              def apiUrl = "https://api.github.com/repos/danish0410/${repoName}/branches"
              def connection = new URL(apiUrl).openConnection()
              connection.setRequestProperty("Authorization", "token ${token}")
              def response = connection.inputStream.text
              def json = new JsonSlurper().parseText(response)
              branches = json*.name
          }
          return branches ?: ['feature']
          '''
        ],
        fallbackScript: [
          classpath: [],
          sandbox: false,
          script: 'return ["feature"]'
        ]
      ]
    ],

    choice(name: 'ENV_STAGE', choices: ['dev', 'staging', 'prod'], description: 'Deployment Environment'),
    string(name: 'LIBRARY_BRANCH', defaultValue: 'feature', description: 'Branch of Shared Library (common-lib-unified)')
  ])
])

pipeline {
  agent any

  tools {
    git 'Git'
  }

  stages {
    stage('Load Shared Library & Init') {
      steps {
        script {
          library("common-lib-unified@${params.LIBRARY_BRANCH}")
          def builderClass = evaluate("org.commonlibunified.ApplicationBuilder")
          app = builderClass.newInstance(this)
          app.initialize(params.REPO_NAME, params.ENV_STAGE)
        }
      }
    }

    stage('Startup Debug') {
      steps {
        echo "⚙️ REPO_NAME: ${params.REPO_NAME}"
        echo "⚙️ REPO_BRANCH: ${params.REPO_BRANCH}"
        echo "⚙️ ENV_STAGE: ${params.ENV_STAGE}"
        echo "📚 LIBRARY_BRANCH: ${params.LIBRARY_BRANCH}"
      }
    }

    stage('Clean Workspace') {
      steps {
        script { app.cleanWorkspace() }
      }
    }

    stage('Checkout Repo') {
      steps {
        script { app.checkout(params.REPO_BRANCH) }
      }
    }

    stage('Build Application') {
      steps {
        script { app.build(params.REPO_BRANCH) }
      }
    }

    stage('Pre-Run Debug') {
      steps {
        script { app.preRunDebug() }
      }
    }

    stage('Start MySQL (if needed)') {
      when {
        expression { app?.appType == 'springboot' }
      }
      steps {
        script { app.startMySQLContainer() }
      }
    }

    stage('Run Container') {
      steps {
        script { app.runContainer() }
      }
    }

    stage('Health Check') {
      steps {
        script { app.healthCheck() }
      }
    }

    stage('Success') {
      steps {
        echo "🎉 Deployment successful for ${params.REPO_NAME} [${params.REPO_BRANCH}] in ${params.ENV_STAGE}"
      }
    }
  }

  post {
    failure {
      echo '❌ Deployment failed. Check logs.'
    }
    always {
      echo '🎯 Pipeline execution completed.'
    }
  }
}
